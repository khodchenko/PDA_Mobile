; Внешний ПДА: настройки экспортёра снимков для моста на ПК.
; Файл читается один раз при запуске игры.

[xpda]
; Папка, куда писать pda_fast.json, pda_slow.json и pda_report.txt.
; Пусто: appdata игры, а если туда записать нельзя, папка сохранений.
; Папка должна уже существовать, игра создавать папки не умеет.
; Пример: snapshot_dir = C:\stalker_pda
snapshot_dir =

; Кодировка игровых строк: auto, cp1251 или utf8.
; auto оставляет корректный UTF-8 как есть, остальное считает cp1251.
text_encoding = auto

; Как часто писать позицию, здоровье и время (50..1000 мс).
fast_period_ms = 100

; Как часто писать имя, деньги и список возможностей (250..10000 мс).
slow_period_ms = 1000
